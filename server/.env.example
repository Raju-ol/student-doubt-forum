PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/student_doubt_forum
JWT_SECRET=
CLIENT_URL=http://127.0.0.1:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional for local development; required in deployed production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only after configuring and testing email delivery.
EMAIL_ENABLED=0
# After verifying a real sender, recovery can launch without restricting posts.
EMAIL_RECOVERY_ENABLED=0
# Enable separately only after verification delivery is working for users.
# Legacy EMAIL_ENABLED=1 still enables both recovery and required verification.
EMAIL_VERIFICATION_REQUIRED=0
APP_URL=http://127.0.0.1:5173
# Optional Google Identity Services web client ID. Leave blank to hide the button.
GOOGLE_CLIENT_ID=
# Resend remains the default. Set to gmail to send through a Gmail account.
EMAIL_PROVIDER=resend
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
# Optional: allow password recovery for only this address while testing.
# Keep EMAIL_ENABLED=0 while using the resend.dev test sender.
EMAIL_TEST_RECIPIENT=
